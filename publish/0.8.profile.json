{
  "id": "github.com/humanagencyprotocol/hap-profiles/publish@0.8",
  "name": "Publishing",
  "version": "0.8",
  "description": "Publishing authority — governs posting public content to social media, blogs, and other platforms",
  "whatsNew": "Protocol v0.8. Platforms, content types and audiences are now declared where the protocol places them (constraint values). Limits and gates are unchanged, so a mandate under 0.7 keeps exactly its terms.",
  "boundsSchema": {
    "actionTypes": [
      "delete",
      "post"
    ],
    "keyOrder": [
      "profile",
      "post_daily_max",
      "post_monthly_max"
    ],
    "fields": {
      "profile": {
        "type": "string",
        "required": true
      },
      "post_daily_max": {
        "type": "number",
        "required": true,
        "displayName": "Daily post limit",
        "description": "Maximum posts published per day",
        "unit": "count",
        "boundType": {
          "kind": "cumulative_count",
          "window": "daily"
        },
        "appliesTo": [
          "post"
        ]
      },
      "post_monthly_max": {
        "type": "number",
        "required": true,
        "displayName": "Monthly post limit",
        "description": "Maximum posts published per month",
        "unit": "count",
        "boundType": {
          "kind": "cumulative_count",
          "window": "monthly"
        },
        "appliesTo": [
          "post"
        ]
      }
    }
  },
  "scopeSchema": {
    "keyOrder": [
      "allowed_platforms",
      "content_type",
      "audience"
    ],
    "fields": {
      "allowed_platforms": {
        "type": "string",
        "required": true,
        "displayName": "Platforms",
        "description": "Authorized publishing platforms",
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ],
          "values": [
            "linkedin"
          ]
        }
      },
      "content_type": {
        "type": "string",
        "required": true,
        "displayName": "Content types",
        "description": "Authorized content formats",
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ],
          "values": [
            "text",
            "image",
            "article"
          ]
        }
      },
      "audience": {
        "type": "string",
        "required": true,
        "displayName": "Audience",
        "description": "Authorized audience visibility",
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ],
          "values": [
            "public",
            "connections"
          ]
        }
      }
    }
  },
  "executionContextSchema": {
    "fields": {
      "allowed_platforms": {
        "source": "declared",
        "description": "Platform being published to (checked against authorized platforms)",
        "required": true,
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ]
        }
      },
      "content_type": {
        "source": "declared",
        "description": "Content format being published",
        "required": true,
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ]
        }
      },
      "audience": {
        "source": "declared",
        "description": "Audience visibility for this post",
        "required": true,
        "constraint": {
          "type": "string",
          "enforceable": [
            "subset"
          ]
        }
      },
      "post_count_daily": {
        "source": "cumulative",
        "cumulativeField": "_count",
        "window": "daily",
        "description": "Running daily post count (resolved from execution log)",
        "required": true,
        "constraint": {
          "type": "number",
          "enforceable": [
            "max"
          ]
        }
      },
      "post_count_monthly": {
        "source": "cumulative",
        "cumulativeField": "_count",
        "window": "monthly",
        "description": "Running monthly post count (resolved from execution log)",
        "required": true,
        "constraint": {
          "type": "number",
          "enforceable": [
            "max"
          ]
        }
      }
    }
  },
  "requiredGates": [
    "bounds",
    "intent",
    "commitment",
    "mandate_owner"
  ],
  "ttl": {
    "default": 86400,
    "max": 31536000
  },
  "retention_minimum": 7776000,
  "content_binding": {
    "version": "1",
    "kind": "text"
  }
}
